# Copy to .env; NEVER commit .env, PIN, or API keys.
OPENAI_API_KEY=
STT_MODEL=gpt-4o-mini-transcribe
# Qwen text reasoning (separate from speech services)
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Change this to a private PIN with at least 4 characters.
PARENT_PIN=

# ElevenLabs preferred; OpenAI TTS fallback
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_SPEED=0.90
