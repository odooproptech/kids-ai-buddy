{
  "expo": {
    "name": "Muknoon",
    "slug": "kids-ai-buddy",
    "scheme": "littlebuddy",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Muknoon needs microphone access to hear your child's answers."
      }
    },
    "android": {
      "permissions": [
        "RECORD_AUDIO"
      ],
      "package": "com.kidsaibuddy.littlebuddy"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Muknoon to record short answers for AI learning."
        }
      ],
      "expo-asset"
    ]
  }
}
